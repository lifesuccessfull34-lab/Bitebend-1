{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fuser -k 8080/tcp 2>/dev/null; export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "pnpm run build && node dist/migrate.mjs",
    "validate:db": "pnpm run build && node dist/validate-db.mjs",
    "seed:dev": "tsx src/seed-dev.ts",
    "seed": "pnpm run build && node dist/seed-dev.mjs",
    "reset-db": "pnpm run build && node dist/reset-db.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@replit/object-storage": "^1.0.0",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/url-utils": "workspace:*",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^4.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.38.0",
    "pino": "^9",
    "pino-http": "^10",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
