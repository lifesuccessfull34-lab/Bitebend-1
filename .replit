modules = ["nodejs-20", "web", "bash"]

  [deployment]
  router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "node artifacts/api-server/dist/migrate.mjs && pnpm run start"]
build = ["bash", "-c", "BASE_PATH=/menu/ pnpm --filter @workspace/menu build && pnpm --filter @workspace/portal build && pnpm --filter @workspace/api-server build"]

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 8080/tcp 5000/tcp 5173/tcp 2>/dev/null; pnpm install --no-frozen-lockfile && export PUPPETEER_EXECUTABLE_PATH=$(which chromium) && pnpm --filter @workspace/api-server run build && node artifacts/api-server/dist/migrate.mjs && (PORT=8080 node --enable-source-maps artifacts/api-server/dist/index.mjs) & (BASE_PATH=/menu/ PORT=5173 pnpm --filter @workspace/menu run dev) & BASE_PATH=/portal/ PORT=5000 pnpm --filter @workspace/portal run dev"
waitForPort = 5000

  [agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3099
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9191
externalPort = 4200

  [nix]
channel = "stable-25_05"

  [userenv]

  [userenv.production]
  SITE_URL = "https://bitebend.in"

[userenv.shared]
PORT = "5000"
NODE_ENV = "development"
PUPPETEER_SKIP_DOWNLOAD = "true"
  