modules = ["nodejs-20", "web", "bash", "postgresql-16"]

  [deployment]
  router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "node artifacts/api-server/dist/migrate.mjs && pnpm run start"]
build = ["pnpm", "run", "build"]

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Portal Dev Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Menu Dev Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WhatsApp Bridge"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Portal Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BASE_PATH=/portal/ PORT=3000 pnpm --filter @workspace/portal run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Menu Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BASE_PATH=/menu/ PORT=5173 pnpm --filter @workspace/menu run dev"
waitForPort = 5173

[[workflows.workflow]]
name = "WhatsApp Bridge"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/whatsapp-bridge run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

  [agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

  [nix]
channel = "stable-25_05"

  [userenv]

  [userenv.production]
  SITE_URL = "https://bitebend.in"

[userenv.shared]
PORT = "5000"
  